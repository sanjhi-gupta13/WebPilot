# WebPilot ProofFlow Environment Configuration
PORT=3001
HEADLESS=true

# AI Provider Selection (builtin_heuristic, openai, anthropic, gemini)
# Default is 'builtin_heuristic' which works offline with zero API keys required
LLM_PROVIDER=builtin_heuristic

# Optional External LLM Credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional ElevenLabs Conversational Voice Credentials
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
